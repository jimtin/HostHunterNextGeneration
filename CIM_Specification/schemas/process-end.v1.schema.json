{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hosthunter.dev/schemas/process-end.v1.schema.json",
  "title": "HostHunter canonical process end v1",
  "allOf": [
    { "$ref": "forensic-event-envelope.v1.schema.json" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["@timestamp", "ecs", "event", "agent", "host", "process", "user", "hosthunter"],
      "properties": {
        "@timestamp": true,
        "ecs": true,
        "event": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": true,
            "kind": { "const": "event" },
            "category": { "const": ["process"] },
            "type": { "const": ["end"] },
            "action": { "const": "process-ended" },
            "dataset": { "const": "hosthunter.process_end" },
            "module": true,
            "provider": true,
            "created": true
          }
        },
        "agent": true,
        "host": true,
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pid", "name", "executable", "end", "exit_code"],
          "properties": {
            "pid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "entity_id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "name": { "type": "string", "minLength": 1, "maxLength": 255 },
            "executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "end": { "$ref": "forensic-event-envelope.v1.schema.json#/$defs/dateTime" },
            "exit_code": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          }
        },
        "user": { "$ref": "#/$defs/principal" },
        "hosthunter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "const": "process.end" },
                "version": { "const": "1.0.0" }
              }
            },
            "collection_run": true,
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": { "const": "Microsoft-Windows-Security-Auditing" },
                "channel": { "const": "Security" },
                "event_code": { "const": "4689" },
                "event_version": { "const": 0 },
                "record_id": true,
                "computer": true
              }
            },
            "provenance": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "transport": true, "collected_at": true, "normalizer": true }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "domain", "logon_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "domain": { "type": "string", "minLength": 1, "maxLength": 255 },
        "logon_id": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 20 }
      }
    }
  }
}
