{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hosthunter.dev/schemas/authentication-session-start.v1.schema.json",
  "title": "HostHunter canonical authentication session start v1",
  "allOf": [
    { "$ref": "forensic-event-envelope.v1.schema.json" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["@timestamp", "ecs", "event", "agent", "host", "user", "hosthunter"],
      "properties": {
        "@timestamp": true,
        "ecs": true,
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome"],
          "properties": {
            "id": true,
            "kind": { "const": "event" },
            "category": { "const": ["authentication"] },
            "type": { "const": ["start"] },
            "action": { "const": "user-logon-succeeded" },
            "dataset": { "const": "hosthunter.authentication_session" },
            "module": true,
            "provider": true,
            "created": true,
            "outcome": { "const": "success" }
          }
        },
        "agent": true,
        "host": true,
        "user": {
          "allOf": [
            { "$ref": "authentication-common.v1.schema.json#/$defs/userWithTarget" },
            {
              "required": ["target"],
              "properties": {
                "target": { "required": ["logon_id"] }
              }
            }
          ]
        },
        "source": { "$ref": "authentication-common.v1.schema.json#/$defs/networkEndpoint" },
        "process": { "$ref": "authentication-common.v1.schema.json#/$defs/process" },
        "hosthunter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "collection_run", "source", "authentication", "provenance"],
          "properties": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version"],
              "properties": {
                "name": { "const": "authentication.session.start" },
                "version": { "const": "1.0.0" }
              }
            },
            "collection_run": true,
            "source": {
              "allOf": [
                { "$ref": "authentication-common.v1.schema.json#/$defs/securityEventSource" },
                {
                  "properties": {
                    "event_code": { "const": "4624" },
                    "event_version": { "enum": [0, 1, 2] }
                  }
                }
              ]
            },
            "authentication": {
              "allOf": [
                { "$ref": "authentication-common.v1.schema.json#/$defs/authenticationContext" },
                {
                  "required": [
                    "logon_type",
                    "logon_process",
                    "authentication_package",
                    "key_length_bits"
                  ]
                }
              ]
            },
            "provenance": true
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hosthunter": {
                "properties": {
                  "source": {
                    "properties": { "event_version": { "const": 0 } },
                    "required": ["event_version"]
                  }
                },
                "required": ["source"]
              }
            },
            "required": ["hosthunter"]
          },
          "then": {
            "properties": {
              "hosthunter": {
                "properties": {
                  "authentication": {
                    "not": {
                      "anyOf": [
                        { "required": ["impersonation_level"] },
                        { "required": ["restricted_admin_mode"] },
                        { "required": ["virtual_account"] },
                        { "required": ["elevated_token"] },
                        { "required": ["linked_logon_id"] },
                        { "required": ["outbound_user"] }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hosthunter": {
                "properties": {
                  "source": {
                    "properties": { "event_version": { "const": 1 } },
                    "required": ["event_version"]
                  }
                },
                "required": ["source"]
              }
            },
            "required": ["hosthunter"]
          },
          "then": {
            "properties": {
              "hosthunter": {
                "properties": {
                  "authentication": {
                    "not": {
                      "anyOf": [
                        { "required": ["restricted_admin_mode"] },
                        { "required": ["virtual_account"] },
                        { "required": ["elevated_token"] },
                        { "required": ["linked_logon_id"] },
                        { "required": ["outbound_user"] }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
