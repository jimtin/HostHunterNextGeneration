{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hosthunter.dev/schemas/process-access-token.v1.schema.json",
  "title": "HostHunter canonical primary process access-token observation v1",
  "allOf": [
    { "$ref": "forensic-event-envelope.v1.schema.json" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["@timestamp", "ecs", "event", "agent", "host", "process", "hosthunter"],
      "properties": {
        "@timestamp": true,
        "ecs": true,
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome"],
          "properties": {
            "id": true,
            "kind": { "const": "state" },
            "category": { "const": ["process", "iam"] },
            "type": { "const": ["info"] },
            "action": { "const": "primary-process-token-observed" },
            "dataset": { "const": "hosthunter.process_access_token" },
            "module": true,
            "provider": true,
            "created": true,
            "outcome": { "enum": ["success", "failure", "unknown"] }
          }
        },
        "agent": true,
        "host": true,
        "process": { "$ref": "authentication-common.v1.schema.json#/$defs/process" },
        "user": {
          "allOf": [
            { "$ref": "authentication-common.v1.schema.json#/$defs/principal" },
            { "required": ["id"] }
          ]
        },
        "hosthunter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "collection_run", "source", "process_token", "provenance"],
          "properties": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version"],
              "properties": {
                "name": { "const": "process.access-token" },
                "version": { "const": "1.0.0" }
              }
            },
            "collection_run": true,
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "channel",
                "event_code",
                "event_version",
                "record_id",
                "computer"
              ],
              "properties": {
                "provider": { "const": "Microsoft Windows API" },
                "channel": { "const": "AccessToken" },
                "event_code": { "const": "primary-process-token" },
                "event_version": { "const": 1 },
                "record_id": { "$ref": "authentication-common.v1.schema.json#/$defs/identifier" },
                "computer": { "$ref": "authentication-common.v1.schema.json#/$defs/shortText" }
              }
            },
            "process_token": {
              "type": "object",
              "additionalProperties": false,
              "required": ["observation"],
              "properties": {
                "observation": {
                  "$ref": "authentication-common.v1.schema.json#/$defs/observation"
                },
                "token": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type"],
                  "properties": {
                    "type": { "const": "primary" },
                    "id": { "$ref": "authentication-common.v1.schema.json#/$defs/uint64Decimal" },
                    "authentication_id": {
                      "$ref": "authentication-common.v1.schema.json#/$defs/uint64Decimal"
                    },
                    "modified_id": {
                      "$ref": "authentication-common.v1.schema.json#/$defs/uint64Decimal"
                    }
                  }
                },
                "privileges": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "enabled",
                      "enabled_by_default",
                      "removed",
                      "used_for_access"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^Se[A-Za-z0-9]+Privilege$"
                      },
                      "enabled": { "type": "boolean" },
                      "enabled_by_default": { "type": "boolean" },
                      "removed": { "type": "boolean" },
                      "used_for_access": { "type": "boolean" }
                    }
                  }
                }
              }
            },
            "provenance": true
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hosthunter": {
                "properties": {
                  "process_token": {
                    "properties": {
                      "observation": {
                        "properties": { "status": { "const": "complete" } },
                        "required": ["status"]
                      }
                    },
                    "required": ["observation"]
                  }
                },
                "required": ["process_token"]
              }
            },
            "required": ["hosthunter"]
          },
          "then": {
            "required": ["user"],
            "properties": {
              "event": { "properties": { "outcome": { "const": "success" } } },
              "process": {
                "anyOf": [{ "required": ["entity_id"] }, { "required": ["start"] }]
              },
              "hosthunter": {
                "properties": {
                  "process_token": { "required": ["token", "privileges"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hosthunter": {
                "properties": {
                  "process_token": {
                    "properties": {
                      "observation": {
                        "properties": { "status": { "const": "partial" } },
                        "required": ["status"]
                      }
                    },
                    "required": ["observation"]
                  }
                },
                "required": ["process_token"]
              }
            },
            "required": ["hosthunter"]
          },
          "then": {
            "properties": {
              "event": { "properties": { "outcome": { "const": "unknown" } } },
              "hosthunter": {
                "properties": {
                  "process_token": {
                    "properties": {
                      "observation": { "required": ["issues"] }
                    },
                    "anyOf": [{ "required": ["token"] }, { "required": ["privileges"] }]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hosthunter": {
                "properties": {
                  "process_token": {
                    "properties": {
                      "observation": {
                        "properties": {
                          "status": { "enum": ["unavailable", "failed"] }
                        },
                        "required": ["status"]
                      }
                    },
                    "required": ["observation"]
                  }
                },
                "required": ["process_token"]
              }
            },
            "required": ["hosthunter"]
          },
          "then": {
            "properties": {
              "event": { "properties": { "outcome": { "const": "failure" } } },
              "hosthunter": {
                "properties": {
                  "process_token": {
                    "properties": {
                      "observation": { "required": ["issues"] }
                    },
                    "not": {
                      "anyOf": [{ "required": ["token"] }, { "required": ["privileges"] }]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
