root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
max_line_length = 160
trim_trailing_whitespace = true

[*.{ps1,psd1,psm1}]
indent_size = 4

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[**/LICENSE-*]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
max_line_length = off
trim_trailing_whitespace = false

[*.evtx]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
max_line_length = off
trim_trailing_whitespace = unset
